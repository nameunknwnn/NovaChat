
generator client {
  provider = "prisma-client"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
}


model User{
  id                 String @id @default(uuid())
  name               String
  email              String @unique
  password           String?
  image              String?
  conversations      Conversation[]
  AuthType           AuthType? @default(GOOGLE)
  authId             String? 
  profiles           Profile[]
}

model Profile{
  id                  String @id @default(uuid())
  name                String 
  occupation          String?
  preferences         String?
  tratis              String?
  user                User   @relation(fields:[userId],references: [id])
  userId              String
  active              Boolean @default(false)
}

model Conversation{
  id                 String @id @default(uuid())
  title              String
  user               User   @relation(fields: [userId],references: [id])
  userId             String
  messages           Message[]
}

model Message{
  id                 Int @id @default(autoincrement())
  content            String
  role               ContentRole
  conversation       Conversation   @relation(fields: [conversationId],references: [id])
  conversationId     String
  createdAt          DateTime @default(now())
}

enum ContentRole{
  ASSISTANT
  USER
}

enum AuthType{
  GOOGLE
  GITHUB
}
